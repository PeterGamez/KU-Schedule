{
  "manifest_version": 3,
  "name": "KU Schedule - ตารางเรียน มก.",
  "version": "1.2.2",
  "description": "ดึงและแสดงผลตารางเรียนของนิสิตผ่านระบบ My KU แบบ Client-Side 100% (Unofficial)",
  "permissions": [
    "scripting",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://my.ku.th/*",
    "https://calendar.google.com/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "204873181745-iosj9ue4ackiau2sraf45dub5uaafv6o.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.app.created",
      "https://www.googleapis.com/auth/calendar.calendarlist.readonly"
    ]
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "ตารางเรียน KU Schedule",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}